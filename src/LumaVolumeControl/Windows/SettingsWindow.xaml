<Window x:Class="LumaVolumeControl.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Luma Volume Control 設定" Width="860" Height="700" MinWidth="760" MinHeight="600" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Border Background="#FC0D0F14" BorderBrush="#3B4254" BorderThickness="1" CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>
            <Grid x:Name="TitleBar" Margin="18,0,10,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="17">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8B6CFF"/><GradientStop Color="#40CEFF" Offset="1"/></LinearGradientBrush></Border.Background>
                    <TextBlock Text="L" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Luma Volume Control" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="設定" Foreground="#99A2B3" FontSize="11"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CloseButton}" Click="Cancel_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#151821" BorderBrush="#303646" BorderThickness="1" CornerRadius="14" Padding="10">
                    <StackPanel>
                        <Button x:Name="GeneralNav" Content="基本設定" HorizontalContentAlignment="Left" Margin="0,0,0,5" Click="GeneralNav_Click"/>
                        <Button x:Name="OverlayNav" Content="オーバーレイ" HorizontalContentAlignment="Left" Margin="0,0,0,5" Click="OverlayNav_Click"/>
                        <Button x:Name="VisualizerNav" Content="ビジュアライザー" HorizontalContentAlignment="Left" Margin="0,0,0,5" Click="VisualizerNav_Click"/>
                        <Button x:Name="AdvancedNav" Content="詳細設定" HorizontalContentAlignment="Left" Margin="0,0,0,5" Click="AdvancedNav_Click"/>
                        <Button x:Name="AboutNav" Content="このアプリについて" HorizontalContentAlignment="Left" Click="AboutNav_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#11141B" BorderBrush="#303646" BorderThickness="1" CornerRadius="14" Padding="22">
                    <Grid>
                        <ScrollViewer x:Name="GeneralPanel" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="2">
                                <TextBlock Text="基本設定" FontSize="23" FontWeight="SemiBold"/>
                                <TextBlock Text="アプリごとの音量を覚え、次回から安全な音量で開始します。" Foreground="#99A2B3" Margin="0,6,0,22"/>
                                <TextBlock Text="アプリの表示言語" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBlock Text="言語は保存後すぐに反映されます。" Foreground="#99A2B3" Margin="0,0,0,9"/>
                                <ComboBox x:Name="AppLanguageCombo" Width="230" HorizontalAlignment="Left" Margin="0,0,0,22">
                                    <ComboBoxItem Content="日本語"/>
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="한국어"/>
                                    <ComboBoxItem Content="简体中文"/>
                                    <ComboBoxItem Content="繁體中文"/>
                                </ComboBox>
                                <Border Style="{x:Null}" Background="#151821" BorderBrush="#303646" BorderThickness="1" CornerRadius="12" Padding="17">
                                    <StackPanel>
                                        <CheckBox x:Name="AutoVolumeCheck" Content="保存したアプリ音量を起動時に自動適用する" Margin="0,2,0,15"/>
                                        <CheckBox x:Name="StartupCheck" Content="Windows起動時に自動起動する" Margin="0,2,0,15"/>
                                        <CheckBox x:Name="StartMinimizedCheck" Content="起動時はトレイに最小化する" Margin="0,2,0,2"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="初めて起動したアプリの音量" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,4"/>
                                <TextBlock Text="保存値がないアプリを最初に検出したときの音量です。" Foreground="#99A2B3"/>
                                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="FirstVolumeSlider" Minimum="0" Maximum="100" TickFrequency="1" ValueChanged="FirstVolumeSlider_ValueChanged"/>
                                    <Border Grid.Column="1" Background="#202431" CornerRadius="9" Margin="12,0,0,0"><TextBlock x:Name="FirstVolumeText" Text="30%" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border>
                                </Grid>
                                <Border Background="#242031" BorderBrush="#5B4B83" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,22,0,0">
                                    <TextBlock Text="ヒント：ミキサーのスライダーを動かすと、アプリ名とその音量を自動で保存します。" Foreground="#D7CAFF" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="OverlayPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="2">
                                <TextBlock Text="オーバーレイ" FontSize="23" FontWeight="SemiBold"/>
                                <TextBlock Text="音量変更を、操作中のモニター中央に滑らかに表示します。" Foreground="#99A2B3" Margin="0,6,0,22"/>
                                <Border Background="#151821" BorderBrush="#303646" BorderThickness="1" CornerRadius="12" Padding="17">
                                    <StackPanel>
                                        <CheckBox x:Name="ShowOverlayCheck" Content="音量変更時にオーバーレイを表示する" Margin="0,2,0,15"/>
                                        <CheckBox x:Name="AnimateCheck" Content="数字とバーを滑らかにアニメーションする" Margin="0,2,0,15"/>
                                        <CheckBox x:Name="ShowVersionCheck" Content="小さなバージョン表示を出す" Margin="0,2,0,2"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="オーバーレイの表示位置" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,5"/>
                                <TextBlock Text="対象アプリがあるモニターを基準に配置します。" Foreground="#99A2B3" Margin="0,0,0,9"/>
                                <ComboBox x:Name="OverlayPositionCombo" Width="250" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="画面中央"/>
                                    <ComboBoxItem Content="上中央"/>
                                    <ComboBoxItem Content="下中央"/>
                                    <ComboBoxItem Content="左上"/>
                                    <ComboBoxItem Content="右上"/>
                                    <ComboBoxItem Content="左下"/>
                                    <ComboBoxItem Content="右下"/>
                                </ComboBox>
                                <TextBlock Text="表示時間" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,4"/>
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="DurationSlider" Minimum="600" Maximum="5000" TickFrequency="100" ValueChanged="DurationSlider_ValueChanged"/>
                                    <Border Grid.Column="1" Background="#202431" CornerRadius="9" Margin="12,0,0,0"><TextBlock x:Name="DurationText" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                </Grid>
                                <TextBlock Text="バージョン表示の位置" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,9"/>
                                <ComboBox x:Name="CornerCombo" Width="220" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="左上"/><ComboBoxItem Content="右上"/><ComboBoxItem Content="左下"/><ComboBoxItem Content="右下"/>
                                </ComboBox>
                                <Button Content="オーバーレイをプレビュー" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,24,0,0" Click="Preview_Click"/>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="VisualizerSettingsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="2">
                                <TextBlock Text="オーディオビジュアライザー" FontSize="23" FontWeight="SemiBold"/>
                                <TextBlock Text="Windowsから再生中の音をリアルタイムに描画します。表示中だけ音声解析を行います。" Foreground="#99A2B3" Margin="0,6,0,22" TextWrapping="Wrap"/>
                                <Border Background="#151821" BorderBrush="#303646" BorderThickness="1" CornerRadius="12" Padding="17">
                                    <StackPanel>
                                        <CheckBox x:Name="VisualizerTopmostCheck" Content="別ウィンドウを常に手前に表示する"/>
                                        <TextBlock Text="初期表示の種類" FontWeight="SemiBold" Margin="0,22,0,8"/>
                                        <ComboBox x:Name="VisualizerStyleSettingsCombo" Width="260" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="ネオン・スペクトラム"/>
                                            <ComboBoxItem Content="スムーズ・ウェーブ"/>
                                            <ComboBoxItem Content="アナログ2連VU"/>
                                            <ComboBoxItem Content="VFDデジタルメーター"/>
                                            <ComboBoxItem Content="LEDステレオメーター"/>
                                            <ComboBoxItem Content="X-Yオシロスコープ"/>
                                        </ComboBox>
                                        <TextBlock Text="音への反応感度（全ビジュアライザー）" FontWeight="SemiBold" Margin="0,22,0,4"/>
                                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="AudioReactionSlider" Minimum="10" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ElementName=AudioReactionSlider, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="スペクトラム感度" FontWeight="SemiBold" Margin="0,22,0,4"/>
                                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="VisualizerSensitivitySlider" Minimum="50" Maximum="200" TickFrequency="5" ValueChanged="VisualizerSensitivitySlider_ValueChanged"/>
                                            <Border Grid.Column="1" Background="#202431" CornerRadius="9" Margin="12,0,0,0"><TextBlock x:Name="VisualizerSensitivityText" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        </Grid>
                                        <TextBlock Text="オシロスコープ感度" FontWeight="SemiBold" Margin="0,22,0,4"/>
                                        <TextBlock Text="X-Y波形の大きさを調整します。100%が標準です。" Foreground="#99A2B3"/>
                                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="OscilloscopeSensitivitySlider" Minimum="25" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OscilloscopeSensitivitySlider_ValueChanged"/>
                                            <Border Grid.Column="1" Background="#202431" CornerRadius="9" Margin="12,0,0,0"><TextBlock x:Name="OscilloscopeSensitivityText" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        </Grid>
                                        <TextBlock Text="描画の滑らかさ" FontWeight="SemiBold" Margin="0,22,0,8"/>
                                        <ComboBox x:Name="VisualizerFpsCombo" Width="180" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="標準（30 FPS）"/>
                                            <ComboBoxItem Content="滑らか（60 FPS）"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <Border Background="#14232A" BorderBrush="#28566A" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,18,0,0">
                                    <TextBlock Text="負荷を抑えるため、ミキサー表示中でもビジュアライザー画面を開いていない間は解析を停止します。" Foreground="#9DDDED" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="AdvancedPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="2">
                                <TextBlock Text="詳細設定" FontSize="23" FontWeight="SemiBold"/>
                                <TextBlock Text="ミキサーの操作感と保存データを管理します。" Foreground="#99A2B3" Margin="0,6,0,22"/>
                                <Border Background="#151821" BorderBrush="#303646" BorderThickness="1" CornerRadius="12" Padding="17">
                                    <StackPanel>
                                        <CheckBox x:Name="CompactMixerCheck" Content="コンパクトモードでミキサーの列を狭くする" Margin="0,0,0,15"/>
                                        <CheckBox x:Name="CloseOnFocusLossCheck" Content="別の場所をクリックしたらミキサーを閉じる"/>
                                        <TextBlock Text="マウスホイール1段の音量" FontWeight="SemiBold" Margin="0,22,0,4"/>
                                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="StepSlider" Minimum="1" Maximum="20" TickFrequency="1" ValueChanged="StepSlider_ValueChanged"/>
                                            <Border Grid.Column="1" Background="#202431" CornerRadius="9" Margin="12,0,0,0"><TextBlock x:Name="StepText" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        </Grid>
                                        <TextBlock Text="ミキサー全体のUIサイズ" FontWeight="SemiBold" Margin="0,22,0,4"/>
                                        <TextBlock Text="文字・カード・バー・ボタンをまとめて縮小します。" Foreground="#99A2B3"/>
                                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="UiScaleSlider" Minimum="70" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="UiScaleSlider_ValueChanged"/>
                                            <Border Grid.Column="1" Background="#202431" CornerRadius="9" Margin="12,0,0,0"><TextBlock x:Name="UiScaleText" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="データ管理" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,11"/>
                                <WrapPanel>
                                    <Button Content="保存した音量をリセット" Margin="0,0,8,8" Click="ResetVolumes_Click"/>
                                    <Button Content="設定フォルダーを開く" Margin="0,0,8,8" Click="OpenSettingsFolder_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="AdvancedStatusText" Foreground="#8FD9B4" Margin="2,8,0,0"/>
                                <TextBlock Text="保存済みアプリ" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,5"/>
                                <TextBlock Text="アプリ名・実行名で検索" Foreground="#99A2B3" Margin="0,4,0,5"/>
                                <TextBox x:Name="SavedAppsSearch" TextChanged="SavedAppsSearch_TextChanged" Margin="0,0,0,10"/>
                                <TextBlock Text="スライダーの変更は即時保存され、起動中のアプリにも適用されます。" TextWrapping="Wrap" Foreground="#99A2B3" Margin="0,0,0,8"/>
                                <TextBlock Text="次に同じアプリが音声を出したとき、この音量を自動適用します。" Foreground="#99A2B3" Margin="0,0,0,11"/>
                                <Border Background="#151821" BorderBrush="#303646" BorderThickness="1" CornerRadius="12" Padding="8">
                                    <Grid>
                                        <TextBlock x:Name="NoSavedAppsText" Text="まだ保存されたアプリはありません" Foreground="#7F899A" HorizontalAlignment="Center" Margin="10,18"/>
                                        <ItemsControl x:Name="SavedAppsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="8,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding ProcessName}" Foreground="#7F899A" FontSize="10" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding ElementName=SavedVolumeSlider, Path=Value, StringFormat={}{0:0}%}" Foreground="#D7CAFF" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        <Slider x:Name="SavedVolumeSlider" Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Volume, Mode=OneWay}" Tag="{Binding Key}" Margin="0,10,0,6" ValueChanged="SavedVolumeSlider_ValueChanged"/>
                                                        <Button Grid.Column="2" Content="×" Tag="{Binding Key}" ToolTip="この保存値を削除" Padding="0" Width="30" Height="28" Margin="8,0,0,0" Click="RemoveSavedApp_Click"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="AboutPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="2">
                                <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Left">
                                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8B6CFF"/><GradientStop Color="#40CEFF" Offset="1"/></LinearGradientBrush></Border.Background>
                                    <TextBlock Text="L" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Luma Volume Control" FontSize="25" FontWeight="SemiBold" Margin="0,16,0,0"/>
                                <TextBlock Text="Version 1.5.3  •  Windows x64" Foreground="#99A2B3" Margin="0,5,0,20"/>
                                <TextBlock Text="Windows 7のように素早く触れる縦型ミキサーを、Lumaシリーズのデザインで再構成しました。アプリが音声セッションを作成した瞬間に保存音量を適用します。" TextWrapping="Wrap" LineHeight="22" MaxWidth="520" HorizontalAlignment="Left"/>
                                <Border Background="#151821" BorderBrush="#303646" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,22,0,0">
                                    <StackPanel><TextBlock Text="使い方" FontWeight="SemiBold"/><TextBlock Text="タスクトレイのLumaアイコンを左クリック：ミキサー&#x0a;右クリック：ミキサー・設定・終了メニュー&#x0a;縦スライダーを動かす：アプリ名と音量を保存" Foreground="#B5BDCA" Margin="0,8,0,0" LineHeight="21"/></StackPanel>
                                </Border>
                                <Button Content="Luma Volume Controlを終了" Foreground="#FF8DA0" HorizontalAlignment="Left" Margin="0,22,0,0" Click="Exit_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="24,10,24,18">
                <TextBlock x:Name="SaveStatusText" VerticalAlignment="Center" Foreground="#8FD9B4"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="キャンセル" MinWidth="104" Margin="0,0,10,0" Click="Cancel_Click"/>
                    <Button Content="保存" MinWidth="116" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
