<Window x:Class="LumaVolumeControl.Windows.MixerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LumaVolumeControl.Controls"
        Title="Luma Volume Control" Width="880" Height="580" MinWidth="660" MinHeight="500" MaxHeight="720"
        WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="VerticalVolumeSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="175"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="False" Margin="0,14">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="#8B6CFF">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Width="6" CornerRadius="3" Background="{TemplateBinding Background}"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="22" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBody" Width="22" Height="16" CornerRadius="8" Background="White" BorderBrush="#8B6CFF" BorderThickness="3"/>
                                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#E5DFFF"/></Trigger></ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="#3A4050">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Width="6" CornerRadius="3" Background="{TemplateBinding Background}"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HorizontalMixerScrollBar" TargetType="ScrollBar">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Height="28" Background="#202431">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                            <RepeatButton Grid.Column="0" Command="ScrollBar.LineLeftCommand" Background="#282D3A" Foreground="#DDE3ED" Content="‹" FontSize="20" Padding="0">
                                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border x:Name="LeftButton" Background="{TemplateBinding Background}" CornerRadius="8,0,0,8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LeftButton" Property="Background" Value="#3A3156"/></Trigger></ControlTemplate.Triggers></ControlTemplate></RepeatButton.Template>
                            </RepeatButton>
                            <Track Grid.Column="1" x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#202431"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb MinWidth="58"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ScrollThumb" Background="#667087" CornerRadius="7" Margin="3,5"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollThumb" Property="Background" Value="#8B6CFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#202431"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                            </Track>
                            <RepeatButton Grid.Column="2" Command="ScrollBar.LineRightCommand" Background="#282D3A" Foreground="#DDE3ED" Content="›" FontSize="20" Padding="0">
                                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border x:Name="RightButton" Background="{TemplateBinding Background}" CornerRadius="0,8,8,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RightButton" Property="Background" Value="#3A3156"/></Trigger></ControlTemplate.Triggers></ControlTemplate></RepeatButton.Template>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MixerSearchBox" TargetType="TextBox">
            <Setter Property="Width" Value="280"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="#F5F7FB"/>
            <Setter Property="Background" Value="#10131A"/>
            <Setter Property="BorderBrush" Value="#59617A"/>
            <Setter Property="CaretBrush" Value="#F5F7FB"/>
            <Setter Property="SelectionBrush" Value="#8B6CFF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="SearchBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SearchBorder" Property="BorderBrush" Value="#8B6CFF"/><Setter TargetName="SearchBorder" Property="BorderThickness" Value="1.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MixerShell" Background="#FA0D0F14" BorderBrush="#3B4254" BorderThickness="1" CornerRadius="20" Padding="1">
        <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="7" Opacity="0.55" Color="Black"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>

            <Grid Margin="20,0,16,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="20">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8B6CFF"/><GradientStop Color="#40CEFF" Offset="1"/></LinearGradientBrush></Border.Background>
                    <Path Data="M 12,18 L 18,18 L 26,12 L 26,28 L 18,22 L 12,22 Z M 29,16 C 33,19 33,21 29,24" Stroke="White" Fill="White" StrokeThickness="2" Stretch="Uniform" Width="22" Height="22"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Luma Volume Control" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DeviceText" Text="オーディオデバイスを確認中…" FontSize="11" Foreground="#99A2B3" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:Name="CompactModeButton" Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="コンパクトモード（Ctrl+M）" Click="CompactMode_Click"
                        Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Viewbox Width="20" Height="16" Stretch="Uniform">
                        <Path Data="M 1,3 L 7,3 M 1,3 L 4,0 M 1,3 L 4,6 M 19,3 L 13,3 M 19,3 L 16,0 M 19,3 L 16,6 M 1,13 L 7,13 M 1,13 L 4,10 M 1,13 L 4,16 M 19,13 L 13,13 M 19,13 L 16,10 M 19,13 L 16,16"
                              Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Viewbox>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" ToolTip="オーディオビジュアライザー" Click="ToggleVisualizer_Click"
                        Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Viewbox Width="20" Height="16" Stretch="Uniform">
                        <Path Data="M 1,4 C 4,1 7,7 10,4 C 13,1 16,7 19,4 M 1,10 C 4,7 7,13 10,10 C 13,7 16,13 19,10"
                              Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Viewbox>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="↻" ToolTip="更新" Click="Refresh_Click"/>
                <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="⚙" ToolTip="設定" Click="Settings_Click"/>
            </Grid>

            <Grid x:Name="MixerToolbar" Grid.Row="1" Margin="18,0,18,10">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="ToolbarDeviceColumn" Width="150"/><ColumnDefinition x:Name="ToolbarGapColumn" Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="デバイス" FontWeight="SemiBold" Foreground="#99A2B3" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <Grid Grid.Column="2">
                    <TextBox x:Name="SearchBox" Style="{StaticResource MixerSearchBox}" HorizontalAlignment="Left" TextChanged="SearchBox_TextChanged" ToolTip="アプリ名で検索"/>
                    <TextBlock x:Name="SearchHint" Text="アプリを検索" Foreground="#6F788A" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="13,0"/>
                </Grid>
            </Grid>

            <Grid x:Name="MixerPanel" Grid.Row="2" Margin="18,0,18,0">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="MixerDeviceColumn" Width="150"/><ColumnDefinition x:Name="MixerGapColumn" Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <Border x:Name="MasterCard" Background="#151821" BorderBrush="#303646" BorderThickness="1" CornerRadius="14" Padding="12">
                    <Grid x:Name="MasterCardGrid">
                        <Grid.RowDefinitions><RowDefinition x:Name="MasterIconRow" Height="48"/><RowDefinition x:Name="MasterNameRow" Height="42"/><RowDefinition x:Name="MasterPercentRow" Height="30"/><RowDefinition Height="*"/><RowDefinition x:Name="MasterMuteRow" Height="46"/></Grid.RowDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12" HorizontalAlignment="Center">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8B6CFF"/><GradientStop Color="#40CEFF" Offset="1"/></LinearGradientBrush></Border.Background>
                            <TextBlock Text="♪" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="1" Text="Windows 全体" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" x:Name="MasterValueText" Text="0%" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <Grid x:Name="MasterMeter" Grid.Row="3" Width="42" Height="175" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="MasterMeterRail" Width="14" Height="147" CornerRadius="7" Background="#282D3A" VerticalAlignment="Center" ClipToBounds="True">
                                <Grid>
                                    <Border x:Name="MasterLevelFill" Width="14" Height="0" CornerRadius="7" VerticalAlignment="Bottom" Opacity="0.9">
                                        <Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="#40CEFF"/><GradientStop Color="#8FFFD2" Offset="1"/></LinearGradientBrush></Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                            <Slider x:Name="MasterSlider" Style="{StaticResource VerticalVolumeSlider}" ValueChanged="MasterSlider_ValueChanged" PreviewMouseWheel="Slider_PreviewMouseWheel" Panel.ZIndex="2"/>
                        </Grid>
                        <Button Grid.Row="4" x:Name="MasterMuteButton" Style="{StaticResource IconButton}" Content="🔊" ToolTip="デバイスをミュート" Click="MasterMute_Click" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <ScrollViewer x:Name="SessionScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" PanningMode="HorizontalOnly" PreviewMouseWheel="SessionScroll_PreviewMouseWheel">
                        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource HorizontalMixerScrollBar}"/></ScrollViewer.Resources>
                        <StackPanel x:Name="SessionList" Orientation="Horizontal" Margin="0,0,0,8"/>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="◌" FontSize="42" Foreground="#59617A" HorizontalAlignment="Center"/>
                        <TextBlock Text="音声を再生中のアプリはありません" Foreground="#99A2B3" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border x:Name="VisualizerPanel" Grid.Row="1" Grid.RowSpan="2" Margin="18,0,18,0" Visibility="Collapsed"
                    Background="#0A0D13" BorderBrush="#303646" BorderThickness="1" CornerRadius="16" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="6,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions>
                        <Button Content="← ミキサー" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Center" Click="BackToMixer_Click"/>
                        <TextBlock Grid.Column="1" Text="AUDIO VISUALIZER" FontSize="13" FontWeight="SemiBold" Foreground="#8B93A3" VerticalAlignment="Center"/>
                        <ComboBox x:Name="VisualizerStyleCombo" Grid.Column="2" Width="230" VerticalAlignment="Center" SelectionChanged="VisualizerStyleCombo_SelectionChanged">
                            <ComboBoxItem Content="ネオン・スペクトラム"/>
                            <ComboBoxItem Content="スムーズ・ウェーブ"/>
                            <ComboBoxItem Content="アナログ2連VU"/>
                            <ComboBoxItem Content="VFDデジタルメーター"/>
                            <ComboBoxItem Content="LEDステレオメーター"/>
                            <ComboBoxItem Content="X-Yオシロスコープ"/>
                        </ComboBox>
                        <Button Grid.Column="3" Content="別ウィンドウ" Padding="10,7" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenVisualizerWindow_Click"/>
                    </Grid>
                    <Border Grid.Row="1" Background="#070A0F" CornerRadius="12" BorderBrush="#1F2938" BorderThickness="1" ClipToBounds="True">
                        <controls:AudioVisualizerControl x:Name="EmbeddedVisualizer"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="20,0">
                <TextBlock x:Name="AutoStatusText" Text="● 自動調整 ON" Foreground="#8FD9B4" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="FooterHint" Text="ホイールで調整 · Escで閉じる · トレイ右クリックで終了" Foreground="#6F788A" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
